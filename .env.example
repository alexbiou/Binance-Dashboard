# All optional. Defaults are the public, keyless Binance market-data endpoints.
NEXT_PUBLIC_BINANCE_REST_URL=https://data-api.binance.vision
NEXT_PUBLIC_BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# If the browser cannot reach Binance directly (CORS or regional blocking),
# route REST calls through the built-in server proxy instead:
# NEXT_PUBLIC_BINANCE_REST_URL=/api/binance
# BINANCE_UPSTREAM_URL=https://data-api.binance.vision
